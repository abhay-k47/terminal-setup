[alias]
  co = checkout
  ci = commit
  st = status
  br = branch
  hist = log --pretty=format:'%C(white)%h %C(green)%cs | %C(blue)%s%C(red)%d %C(yellow)[%an]' --graph --date=short
  type = cat-file -t
  dump = cat-file -p

[core]
  pager = delta

[delta]
  side-by-side = true
  navigate = true
  light = false

[diff]
  algorithm = histogram

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictstyle = zdiff3

[push]
  autoSetupRemote = true

[rerere]
  enabled = true

[help]
  autocorrect = prompt
